# Authentication: keep 0 for the existing local single-user workflow.
EPM_AUTH=0

# When EPM_AUTH=1, this username is allowed to administer question-bank settings.
EPM_ADMIN_USERNAME=

# Optional deployment paths. Do not put secrets in this file.
EPM_DATA_DIR=
EPM_FRONTEND_DIST=

# Optional API-key gate for deployments behind a trusted client.
EPM_API_KEY=
EPM_RATE_LIMIT=120
EPM_TRUST_PROXY=

# Optional daily AI quota per authenticated user; 0 disables the quota.
EPM_AI_DAILY_QUOTA=0
