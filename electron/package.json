{
  "name": "ai-english-practice-desktop",
  "version": "2.0.0-beta.15",
  "description": "AI 英语刷题机 - 桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.sora.englishpractice",
    "productName": "AI英语刷题机",
    "artifactName": "epm-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "mo9652962-ai",
        "repo": "epm-releases"
      }
    ],
    "files": [
      "main.js",
      "../frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!data/**",
          "!dist/**",
          "!build/**"
        ]
      },
      {
        "from": "..",
        "to": "app",
        "filter": [
          "run_app.py",
          "requirements.txt"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../backend/dist/backend_app",
        "to": "backend_app",
        "filter": [
          "**/*",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../backend/data/question_bank.db",
        "to": "seed/question_bank.db"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "installer-assets/installer.ico"
    },
    "nsis": {
      "artifactName": "epm-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "installer-assets/installer.ico",
      "installerHeaderIcon": "installer-assets/installer-header.bmp",
      "installerSidebar": "installer-assets/installer-sidebar.bmp"
    },
    "portable": {
      "artifactName": "epm-portable-${version}.${ext}"
    }
  }
}