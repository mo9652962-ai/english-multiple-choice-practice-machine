{
  "name": "ai-english-practice-desktop",
  "version": "1.0.2",
  "description": "AI 英语刷题机 - 桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.sora.englishpractice",
    "productName": "AI英语刷题机",
    "artifactName": "epm-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "mo9652962-ai",
        "repo": "epm-releases"
      }
    ],
    "files": [
      "main.js",
      "../frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "..",
        "to": "app",
        "filter": [
          "run_app.py",
          "requirements.txt"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../frontend/public/brand-mark.png"
    },
    "nsis": {
      "artifactName": "epm-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "epm-portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
